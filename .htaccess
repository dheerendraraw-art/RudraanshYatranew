# Add MIME types for WEBP images, MP4/WEBM videos, and WOFF2 fonts
AddType image/webp .webp
AddType video/mp4 .mp4
AddType video/webm .webm
AddType font/woff2 .woff2

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Disable LiteSpeed Cache for admin page to prevent stale cache serving
    RewriteCond %{REQUEST_URI} ^/(admin|admin\.html)$ [NC]
    RewriteRule .* - [E=Cache-Control:no-cache]

    # Redirect direct requests for index.html or index to /
    RewriteCond %{THE_REQUEST} \s/+(index|index\.html)[\s?] [NC]
    RewriteRule ^ / [R=301,L]

    # Redirect direct requests for page.html to /page
    RewriteCond %{THE_REQUEST} \s/+(.*?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Rewrite /page back to page.html internally if page.html exists and is not a directory
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>

# Hostinger / LiteSpeed & Apache HTTP Caching Headers
<IfModule mod_headers.c>
    # 1-year immutable cache for images, videos, fonts, and static assets
    <FilesMatch "\.(webp|png|jpg|jpeg|gif|svg|ico|mp4|webm|woff2|woff|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # 1-year immutable cache for versioned CSS and JS files
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Short revalidating cache for HTML pages
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>

    # Security Headers
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(self)"
</IfModule>

# Gzip / Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml font/woff2 application/x-font-ttf
</IfModule>

# Browser Caching (Expires Headers)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresDefault "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>
